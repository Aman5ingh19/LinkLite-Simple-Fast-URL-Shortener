generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ShortUrl {
  id          String   @id @default(cuid())
  originalUrl String   @db.Text
  shortCode   String   @unique
  clickCount  Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([shortCode])
  @@index([createdAt])
  @@map("short_urls")
}
