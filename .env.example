# ==========================================
# LinkLite Environment Variables Configuration
# ==========================================

# PostgreSQL Database Connection URL
# Example for local PostgreSQL:
# DATABASE_URL="postgresql://username:password@localhost:5432/linklite?schema=public"
# Example for hosted provider (Neon, Supabase, Railway, Vercel Postgres):
# DATABASE_URL="postgresql://user:password@ep-host.region.aws.neon.tech/linklite?sslmode=require"
DATABASE_URL="postgresql://username:password@localhost:5432/linklite?schema=public"

# Application Base URL (for generating and copying short URLs)
# In production on Vercel: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
